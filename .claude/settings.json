{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(node --test *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree*)",
      "Bash(git remote -v)",
      "Bash(bash .claude/skills/file-headers/scripts/check-headers.sh)",
      "Bash(bash .claude/skills/i18n-parity/scripts/i18n-audit.sh)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git checkout -B *)",
      "Bash(git switch *)",
      "Bash(git stash*)",
      "Bash(git merge origin/*)",
      "Bash(git pull origin *)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm install)",
      "Bash(npm --prefix client ci*)",
      "Bash(npm --prefix mcp ci*)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx vite build*)",
      "Bash(npx vitest run*)",
      "Bash(npx tsc -b*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx prettier --check *)",
      "Bash(curl http://localhost*)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl -sS http://localhost*)",
      "Bash(curl -s http://127.0.0.1*)",
      "Bash(curl -sS http://127.0.0.1*)",
      "Bash(gh pr create *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr merge *)",
      "mcp__github__get_file_contents",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "mcp__github__list_branches",
      "mcp__github__list_commits",
      "mcp__github__get_commit",
      "mcp__github__get_check_run",
      "mcp__github__get_job_logs",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__issue_read",
      "mcp__github__search_code",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__issue_write",
      "mcp__github__add_issue_comment",
      "mcp__github__merge_pull_request",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "mcp__claude-code-remote__read_documentation"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(git restore*)",
      "Bash(npm update*)",
      "Bash(npm uninstall*)",
      "Bash(npm run clear-data*)",
      "Bash(wget *)",
      "Bash(gh release *)",
      "Bash(gh repo delete*)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm --recursive --force *)",
      "Bash(find * -delete*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development.local)",
      "Read(.env.test.local)",
      "Read(.env.production.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(secrets/**)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.development.local)",
      "Edit(.env.test.local)",
      "Edit(.env.production.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(secrets/**)",
      "Edit(**/secrets/**)"
    ]
  },
  "sandbox": {
    "enabled": false,
    "failIfUnavailable": false,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        ".env",
        ".env.local",
        ".env.development.local",
        ".env.test.local",
        ".env.production.local",
        "secrets",
        "~/.ssh",
        "~/.aws",
        "~/.config/gcloud",
        "~/.kube"
      ]
    },
    "credentials": {
      "envVars": [
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "ANTHROPIC_AUTH_TOKEN", "mode": "deny" },
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" }
      ]
    }
  }
}
